{
  "schemaVersion": 1,
  "status": "awaiting-local-keys-and-live-verification",
  "requestsEnabled": false,
  "dailyBudget": null,
  "costPreference": "quality-first-task-fit-no-daily-cap",
  "coordinator": "current-codex-session",
  "executionMode": "local-api-bridge-current-codex-applies-reviews-and-tests",
  "workflows": {
    "normal": ["implementer", "reviewer", "local-verification"],
    "complex": ["expert", "implementer", "reviewer", "local-verification"]
  },
  "integrationCandidates": {
    "currentCodexBridge": "https://github.com/BeehiveInnovations/pal-mcp-server",
    "independentMultiProviderAgents": "https://github.com/anomalyco/opencode",
    "providerGateway": "https://github.com/musistudio/claude-code-router"
  },
  "providers": {
    "relay": {
      "baseUrl": "https://api.ipc.wiki",
      "protocol": "openai-chat-completions",
      "apiKeyEnvironmentVariable": "MODEL_TEAM_RELAY_API_KEY",
      "models": {
        "sonnet": {
          "requestedModel": "claude-sonnet-5-5",
          "actualModelId": "claude-sonnet-5-5",
          "pricePerMillionTokens": null
        },
        "opus": {
          "requestedModel": "claude-opus-5-5",
          "actualModelId": "claude-opus-5-5",
          "pricePerMillionTokens": null
        }
      }
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com",
      "protocol": "openai-chat-completions",
      "apiKeyEnvironmentVariable": "MODEL_TEAM_DEEPSEEK_API_KEY",
      "models": {
        "flash": {
          "requestedModel": "DeepSeek-V4.1-Flash",
          "actualModelId": "deepseek-flash",
          "pricePerMillionTokens": null,
          "pricingSource": "https://api-docs.deepseek.com/quick_start/pricing/"
        }
      }
    }
  },
  "roles": {
    "reviewer": {
      "provider": "current-codex-session",
      "model": "current-session",
      "purpose": "primary-independent-review-debugging-local-tests-and-final-acceptance"
    },
    "scout": {
      "provider": "deepseek",
      "model": "flash",
      "purpose": "bounded-code-inspection-log-summary-documentation-and-test-case-suggestions",
      "mayCoordinateTeam": false,
      "mayApproveCriticalChanges": false,
      "fallbackRole": "implementer"
    },
    "implementer": {
      "provider": "relay",
      "model": "sonnet",
      "purpose": "primary-frontend-backend-business-logic-and-full-stack-implementation",
      "fallbackRole": "expert"
    },
    "expert": {
      "provider": "relay",
      "model": "opus",
      "purpose": "complex-architecture-difficult-problem-solving-and-optional-independent-second-opinion",
      "automaticEveryTaskReview": false,
      "directAssignmentForComplexTasks": true,
      "fallbackRole": null
    }
  },
  "policy": {
    "selectionBasis": "capability-task-complexity-user-benchmark-screenshots-and-project-validation",
    "benchmarkEvidence": "docs/model-team-video-reference.md",
    "benchmarkScoresArePassRates": false,
    "mandatoryCheapFirst": false,
    "useLocalToolsFirst": true,
    "automaticHttpRetries": 0,
    "sendWholeRepository": false,
    "sendWholeChat": false,
    "externalModelsMayExecuteCommands": false,
    "externalModelsMayWriteFiles": false,
    "verifyChangesLocally": true,
    "usageMustBeReportedAsUnknownWhenMissing": true,
    "recordFailedAttemptCosts": true
  }
}
